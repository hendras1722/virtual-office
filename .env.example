# Public provider endpoints; keys are added in the application, never in VITE_* variables.
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
APP_ORIGIN=http://localhost:5173

# Optional executable paths (no shell command or additional arguments).
# Leave unset when omp/hermes/codex are already on the server's PATH.
# OMP_COMMAND=/absolute/path/to/omp
# HERMES_COMMAND=/absolute/path/to/hermes
# CODEX_COMMAND=/absolute/path/to/codex
# ANTIGRAVITY_COMMAND=/absolute/path/to/agy_acp_server.par
# CLAUDE_COMMAND=/absolute/path/to/claude
